# Apex Margin Advisor — Environment Configuration (copy to .env; never commit real secrets)

# Database backend: "duckdb" (zero-dependency local file) or "mssql" (SQL Server 2022 with native RLS)
DB_BACKEND=duckdb
DUCKDB_PATH=data/apex_margin.duckdb

# SQL Server connection (optional, used when DB_BACKEND=mssql)
DB_HOST=localhost
DB_PORT=1433
DB_NAME=apex_margin
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=
MSSQL_APP_USER=apex_reader
MSSQL_APP_PASSWORD=
ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERT=yes

# Deterministic demo clock & seed
AS_OF_DATE=2026-11-20
DEMO_SEED=42

# Conversational LLM configuration ("rules" runs 100% deterministic offline without an LLM)
LLM_MODEL=rules
LLM_MODEL_CHOICES=ollama/qwen2.5-coder:14b,ollama/gpt-oss:20b,gemini/gemini-2.5-flash,openai/gpt-4o-mini
OLLAMA_API_BASE=http://localhost:11434
OLLAMA_NUM_CTX=8192
GPT_OSS_REASONING_EFFORT=low
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180

# Optional cloud provider keys via LiteLLM
GEMINI_API_KEY=
OPENAI_API_KEY=

# Shared demo sign-in access code & persistent local stores
APP_ACCESS_CODE=apex-demo-2026
APP_HISTORY_DB=data/app_history.sqlite
CAT_ACTION_DB=data/cat_actions.sqlite
